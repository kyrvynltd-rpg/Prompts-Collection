# Copy to .env for local use. Never commit the real file.

# --- Access codes (workshops, vouchers). Leave empty to keep codes disabled.
ENTITLEMENT_SECRET=

# --- Database. Empty = local SQLite file (APP_DB_PATH, default promptlab.db).
# Production: a Postgres URL (Supabase, Neon). Also: pip install -r requirements-postgres.txt
DATABASE_URL=
APP_DB_PATH=

# --- Prices shown in the app (the real charge is set in the payment provider; keep them equal)
PRICE_PLUS_MONTHLY_GBP=4.99
PRICE_PLUS_ANNUAL_GBP=39.99
PRICE_PRO_MONTHLY_GBP=9.99
PRICE_PRO_ANNUAL_GBP=99.99

# --- Payments: one hosted checkout link per provider, tier and period, created in the provider dashboard.
# Empty = that button is hidden. Pattern: <PROVIDER>_LINK_<TIER>_<PERIOD>. Set metadata plan=plus|pro on each Stripe link.
STRIPE_LINK_PLUS_MONTHLY=
STRIPE_LINK_PLUS_ANNUAL=
STRIPE_LINK_PRO_MONTHLY=
STRIPE_LINK_PRO_ANNUAL=
LEMONSQUEEZY_LINK_PLUS_MONTHLY=
LEMONSQUEEZY_LINK_PLUS_ANNUAL=
LEMONSQUEEZY_LINK_PRO_MONTHLY=
LEMONSQUEEZY_LINK_PRO_ANNUAL=
PAYPAL_LINK_PLUS_MONTHLY=
PAYPAL_LINK_PRO_MONTHLY=
# Webhook signing secrets (webhook service only)
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Student verification: extra accepted email endings besides .ac.uk (comma separated)
STUDENT_EMAIL_SUFFIXES=

# --- Pro: AI feedback. Off until AI_API_KEY is set. Any OpenAI-compatible endpoint.
AI_API_KEY=
AI_API_URL=
AI_MODEL=
AI_MONTHLY_CAP=30

# --- Owner details shown in the footer and legal pages (see docs/OWNERSHIP.md)
OWNER_NAME=Kyrvyn Ltd
COMPANY_NUMBER=17246800
REGISTERED_OFFICE=Office 15 Exning Road, E16 4NB
SITE_URL=https://kyrvynltd.co.uk
CONTACT_EMAIL=info@kyrvynltd.co.uk

# --- Retention in days (defaults shown; see docs/DATA_RETENTION.md)
RETAIN_AUDIT_DAYS=365
RETAIN_LOGIN_ATTEMPT_DAYS=30
RETAIN_EVENT_DAYS=730
RETAIN_AI_USAGE_DAYS=400
